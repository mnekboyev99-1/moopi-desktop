{
  "name": "moopi-desktop",
  "displayName": "MOOPI",
  "description": "MOOPI: Bugun, Tasdiqlar, Fayllar panellari, ovozli yordamchi — Claude Code bilan bir oynada.",
  "version": "0.9.5",
  "publisher": "moopi",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/mnekboyev99-1/moopi-desktop"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "moopi",
          "title": "MOOPI",
          "icon": "media/moopi.svg"
        }
      ]
    },
    "views": {
      "moopi": [
        {
          "type": "webview",
          "id": "moopi.bugun",
          "name": "Bugun"
        },
        {
          "type": "webview",
          "id": "moopi.tasdiqlar",
          "name": "Tasdiqlar"
        },
        {
          "type": "webview",
          "id": "moopi.fayllar",
          "name": "Fayllar"
        }
      ],
      "claude-sidebar-secondary": [
        {
          "type": "webview",
          "id": "moopi.yordamchi",
          "name": "MOOPI",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "moopi.signIn",
        "title": "MOOPI: Kirish"
      },
      {
        "command": "moopi.signOut",
        "title": "MOOPI: Chiqish"
      },
      {
        "command": "moopi.refresh",
        "title": "MOOPI: Yangilash",
        "icon": "$(refresh)"
      },
      {
        "command": "moopi.openClaude",
        "title": "MOOPI: Claude bilan suhbat",
        "icon": "$(sparkle)"
      },
      {
        "command": "moopi.sendLogs",
        "title": "MOOPI: Xatoni yuborish (jurnal)",
        "icon": "$(bug)"
      },
      {
        "command": "moopi.openApp",
        "title": "MOOPI: Ilovani ochish"
      },
      {
        "command": "moopi.reloadApp",
        "title": "MOOPI: Ilovani qayta yuklash"
      },
      {
        "command": "moopi.voiceToggle",
        "title": "MOOPI: Ovozli javob (yoqish/o'chirish)"
      },
      {
        "command": "moopi.dictate",
        "title": "MOOPI: Gapirib yozish"
      },
      {
        "command": "moopi.checkUpdate",
        "title": "MOOPI: Yangilanishni tekshirish"
      },
      {
        "command": "moopi.talk",
        "title": "MOOPI: Gapirish (yordamchi)"
      },
      {
        "command": "moopi.assistant",
        "title": "MOOPI: Yordamchi"
      },
      {
        "command": "moopi.askScreen",
        "title": "MOOPI: Ekrandan so'rash"
      },
      {
        "command": "moopi.askClipboard",
        "title": "MOOPI: Nusxalaganimni berish"
      },
      {
        "command": "moopi.assistantNew",
        "title": "MOOPI: Yangi suhbat",
        "icon": "$(add)"
      },
      {
        "command": "moopi.assistantStop",
        "title": "MOOPI: Ovozni to'xtatish",
        "icon": "$(debug-stop)"
      },
      {
        "command": "moopi.usage",
        "title": "MOOPI: Claude limiti (/usage)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "moopi.refresh",
          "when": "view =~ /^moopi\\.(bugun|tasdiqlar|fayllar)$/",
          "group": "navigation"
        },
        {
          "command": "moopi.openClaude",
          "when": "view == moopi.bugun",
          "group": "navigation"
        },
        {
          "command": "moopi.sendLogs",
          "when": "view == moopi.bugun",
          "group": "navigation"
        },
        {
          "command": "moopi.assistantStop",
          "when": "view == moopi.yordamchi && moopi.speaking",
          "group": "navigation@1"
        },
        {
          "command": "moopi.assistantNew",
          "when": "view == moopi.yordamchi",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "MOOPI",
      "properties": {
        "moopi.apiUrl": {
          "type": "string",
          "default": "https://moopi.uz/api",
          "description": "MOOPI API manzili."
        },
        "moopi.appUrl": {
          "type": "string",
          "default": "https://moopi.uz/app/",
          "description": "MOOPI ilovasining veb manzili (oynaning o'rtasida ochiladi)."
        },
        "moopi.language": {
          "type": "string",
          "enum": [
            "uz",
            "ru"
          ],
          "default": "uz",
          "description": "Panellar tili."
        },
        "moopi.autoUpdate": {
          "type": "boolean",
          "default": true,
          "description": "MOOPI kengaytmasi GitHub'dagi yangi nashrni o'zi o'rnatadi."
        },
        "moopi.updateRepo": {
          "type": "string",
          "default": "mnekboyev99-1/moopi-desktop",
          "description": "Yangilanishlar olinadigan GitHub ombori."
        }
      }
    },
    "themes": [
      {
        "label": "MOOPI Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/moopi-dark.json"
      },
      {
        "label": "MOOPI Light",
        "uiTheme": "vs",
        "path": "./themes/moopi-light.json"
      }
    ],
    "keybindings": [
      {
        "command": "moopi.talk",
        "key": "ctrl+alt+m",
        "mac": "ctrl+alt+m"
      },
      {
        "command": "moopi.dictate",
        "key": "ctrl+alt+d",
        "mac": "ctrl+alt+d"
      },
      {
        "command": "moopi.askScreen",
        "key": "ctrl+alt+s",
        "mac": "ctrl+alt+s"
      },
      {
        "command": "moopi.askClipboard",
        "key": "ctrl+alt+c",
        "mac": "ctrl+alt+c"
      },
      {
        "command": "moopi.voiceToggle",
        "key": "ctrl+alt+v",
        "mac": "ctrl+alt+v"
      }
    ]
  }
}
