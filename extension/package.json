{
  "name": "moopi-desktop",
  "displayName": "MOOPI",
  "description": "MOOPI panellari: Bugun, Tasdiqlar, Fayllar — Claude Code bilan bir oynada.",
  "version": "0.5.0",
  "publisher": "moopi",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/mnekboyev99-1/moopi-desktop"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "moopi",
          "title": "MOOPI",
          "icon": "media/moopi.svg"
        }
      ]
    },
    "views": {
      "moopi": [
        {
          "type": "webview",
          "id": "moopi.bugun",
          "name": "Bugun"
        },
        {
          "type": "webview",
          "id": "moopi.tasdiqlar",
          "name": "Tasdiqlar"
        },
        {
          "type": "webview",
          "id": "moopi.fayllar",
          "name": "Fayllar"
        }
      ]
    },
    "commands": [
      {
        "command": "moopi.signIn",
        "title": "MOOPI: Kirish"
      },
      {
        "command": "moopi.signOut",
        "title": "MOOPI: Chiqish"
      },
      {
        "command": "moopi.refresh",
        "title": "MOOPI: Yangilash",
        "icon": "$(refresh)"
      },
      {
        "command": "moopi.openClaude",
        "title": "MOOPI: Claude bilan suhbat",
        "icon": "$(sparkle)"
      },
      {
        "command": "moopi.sendLogs",
        "title": "MOOPI: Xatoni yuborish (jurnal)",
        "icon": "$(bug)"
      },
      {
        "command": "moopi.openApp",
        "title": "MOOPI: Ilovani ochish"
      },
      {
        "command": "moopi.reloadApp",
        "title": "MOOPI: Ilovani qayta yuklash"
      },
      {
        "command": "moopi.voiceToggle",
        "title": "MOOPI: Ovozli javob (yoqish/o'chirish)"
      },
      {
        "command": "moopi.dictate",
        "title": "MOOPI: Gapirib yozish"
      },
      {
        "command": "moopi.checkUpdate",
        "title": "MOOPI: Yangilanishni tekshirish"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "moopi.refresh",
          "when": "view =~ /^moopi\\./",
          "group": "navigation"
        },
        {
          "command": "moopi.openClaude",
          "when": "view == moopi.bugun",
          "group": "navigation"
        },
        {
          "command": "moopi.sendLogs",
          "when": "view == moopi.bugun",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "MOOPI",
      "properties": {
        "moopi.apiUrl": {
          "type": "string",
          "default": "https://sessions.moopi.uz/moopi-api",
          "description": "MOOPI API manzili."
        },
        "moopi.appUrl": {
          "type": "string",
          "default": "https://sessions.moopi.uz/app/",
          "description": "MOOPI ilovasining veb manzili (oynaning o'rtasida ochiladi)."
        },
        "moopi.language": {
          "type": "string",
          "enum": [
            "uz",
            "ru"
          ],
          "default": "uz",
          "description": "Panellar tili."
        },
        "moopi.autoUpdate": {
          "type": "boolean",
          "default": true,
          "description": "MOOPI kengaytmasi GitHub'dagi yangi nashrni o'zi o'rnatadi."
        },
        "moopi.updateRepo": {
          "type": "string",
          "default": "mnekboyev99-1/moopi-desktop",
          "description": "Yangilanishlar olinadigan GitHub ombori."
        }
      }
    },
    "themes": [
      {
        "label": "MOOPI Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/moopi-dark.json"
      }
    ],
    "keybindings": [
      {
        "command": "moopi.voiceToggle",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v"
      },
      {
        "command": "moopi.dictate",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m"
      }
    ]
  }
}
